C4Component
    title Nivel 3 - Componentes: API do Deviante (Kotlin/Ktor)

    Container(web, "Web App", "React + Vite", "SPA do produto")
    System_Ext(auth, "Supabase Auth", "Identidade / JWKS")
    System_Ext(mining, "Servico de Mineracao", "FastAPI - ADWIN / PM4Py")
    ContainerDb(db, "Postgres", "Banco", "Supabase")

    Container_Boundary(api, "API - Kotlin/Ktor") {
        Component(authPlugin, "Auth Plugin", "Ktor / JWT", "Valida o token do Supabase e injeta o usuario.")
        Component(routes, "Routes / Controllers", "Ktor Routing", "Endpoints JSON /api/*, binding request/response.")

        %% Dominio - espelha o OOUX
        Component(process, "Process", "Servico de dominio", "Contexto da cadeia produtiva; agrega operacoes e analises.")
        Component(operation, "Operation", "Servico de dominio", "Atividade normalizada a partir dos eventos do log.")
        Component(analysis, "Analysis", "Servico de dominio", "Roda a analise de desvio e persiste o resultado.")
        Component(action, "Proactive Action", "Servico de dominio", "Recomendacao / agendamento de manutencao.")
        Component(monitoring, "Monitoring", "Servico de dominio", "Saude de equipamento; liga maquina e processo.")

        %% Tecnico - sem objeto OOUX
        Component(parser, "Event-log Parser", "Kotlin", "Converte XES/CSV em traces e operacoes.")
        Component(detector, "Drift Detector Client", "Kotlin", "Chama o servico de mineracao e trata a resposta.")
        Component(repo, "Repositories", "Exposed / JDBC", "Persistencia por agregado.")
    }

    Rel(web, routes, "Chama endpoints", "REST /api/* (JSON)")
    Rel(routes, authPlugin, "Exige autenticacao", "")
    Rel(authPlugin, auth, "Busca chaves", "JWKS")

    Rel(routes, process, "CRUD de processo", "")
    Rel(routes, analysis, "Dispara analise", "")
    Rel(routes, monitoring, "Consulta saude", "")

    Rel(parser, operation, "Cria operacoes", "")
    Rel(process, analysis, "Contextualiza", "")
    Rel(analysis, detector, "Pede deteccao", "")
    Rel(detector, mining, "Detecta drift", "REST /monitoring/detect")
    Rel(analysis, action, "Gera recomendacao", "")
    Rel(monitoring, detector, "Saude via ADWIN", "")

    Rel(process, repo, "Persiste", "")
    Rel(analysis, repo, "Persiste", "")
    Rel(operation, repo, "Persiste", "")
    Rel(repo, db, "SQL", "JDBC")

    UpdateLayoutConfig($c4ShapeInRow="2", $c4BoundaryInRow="1")
