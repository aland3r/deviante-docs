<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<featureModel>
	<properties>
		<graphics key="showconstraints" value="true"/>
		<graphics key="showshortnames" value="false"/>
		<graphics key="layout" value="horizontal"/>
		<graphics key="showcollapsedconstraints" value="true"/>
		<graphics key="legendhidden" value="false"/>
		<graphics key="legendautolayout" value="true"/>
		<graphics key="autolayoutconstraints" value="true"/>
		<graphics key="layoutalgorithm" value="1"/>
	</properties>
	<struct>
		<and abstract="true" mandatory="true" name="Deviante">
			<description>Deviante</description>
			<and abstract="true" mandatory="true" name="Login">
				<description>Login</description>
				<alt abstract="true" mandatory="true" name="Autenticacao">
					<description>Autenticação</description>
					<feature name="LoginDemo">
						<description>Login demo</description>
					</feature>
					<feature name="LoginGoogle">
						<description>Login Google</description>
					</feature>
				</alt>
				<or abstract="true" mandatory="true" name="Papeis">
					<description>Papéis</description>
					<feature name="Administrador">
						<description>Administrador</description>
					</feature>
					<feature name="Operador">
						<description>Operador</description>
					</feature>
					<feature name="Gestor">
						<description>Gestor</description>
					</feature>
					<feature name="Tecnico">
						<description>Técnico</description>
					</feature>
				</or>
			</and>
			<or abstract="true" mandatory="true" name="Workspace">
				<description>Workspace</description>
				<feature name="Monitoramento">
					<description>Monitoramento</description>
				</feature>
				<and name="Processo">
					<description>Processo</description>
					<or abstract="true" mandatory="true" name="FormatoLog">
						<description>Formato do log</description>
						<feature name="XES">
							<description>XES</description>
						</feature>
						<feature name="CSV">
							<description>CSV</description>
						</feature>
					</or>
					<feature mandatory="true" name="MapeamentoAtividades">
						<description>Mapeamento de atividades</description>
					</feature>
					<and mandatory="true" name="GrafoProcesso">
						<description>Grafo do processo</description>
						<feature name="NotasAtividade">
							<description>Notas da atividade</description>
						</feature>
					</and>
					<or abstract="true" name="Filtros">
						<description>Filtros</description>
						<feature name="FiltrarTraces">
							<description>Filtrar traces</description>
						</feature>
						<feature name="FiltrarVariantes">
							<description>Filtrar variantes</description>
						</feature>
						<feature name="FiltrarAtividades">
							<description>Filtrar atividades</description>
						</feature>
					</or>
				</and>
			</or>
			<and abstract="true" name="Equipamento">
				<description>Equipamento</description>
				<feature mandatory="true" name="Maquina">
					<description>Máquina</description>
				</feature>
				<feature name="Componente">
					<description>Componente</description>
				</feature>
			</and>
			<or abstract="true" mandatory="true" name="Analise">
				<description>Análise</description>
				<feature name="Desvio">
					<description>Desvio de processo (drift)</description>
				</feature>
				<feature name="RUL">
					<description>Vida útil restante (RUL)</description>
				</feature>
			</or>
			<or name="Agendamento">
				<description>Agendamento</description>
				<feature name="Inspecao">
					<description>Inspeção</description>
				</feature>
				<feature name="Manutencao">
					<description>Manutenção</description>
				</feature>
			</or>
		</and>
	</struct>
	<constraints>
		<rule>
			<description>R01. O técnico só trabalha na agenda; sem Agendamento ele não tem tela.</description>
			<imp>
				<var>Tecnico</var>
				<var>Agendamento</var>
			</imp>
		</rule>
		<rule>
			<description>R02. O drift é detectado no log de eventos de um processo.</description>
			<imp>
				<var>Desvio</var>
				<var>Processo</var>
			</imp>
		</rule>
		<rule>
			<description>R03. O RUL usa as leituras de sensores das máquinas monitoradas.</description>
			<imp>
				<var>RUL</var>
				<var>Monitoramento</var>
			</imp>
		</rule>
		<rule>
			<description>R04. Todo agendamento é de uma máquina: sem cadastro de máquinas não há agenda.</description>
			<imp>
				<not>
					<var>Maquina</var>
				</not>
				<not>
					<var>Agendamento</var>
				</not>
			</imp>
		</rule>
		<rule>
			<description>R05. O monitoramento acompanha máquinas já cadastradas.</description>
			<imp>
				<var>Monitoramento</var>
				<var>Maquina</var>
			</imp>
		</rule>
		<rule>
			<description>R06. A inspeção é feita pelo operador ou pelo técnico.</description>
			<imp>
				<var>Inspecao</var>
				<disj>
					<var>Operador</var>
					<var>Tecnico</var>
				</disj>
			</imp>
		</rule>
		<rule>
			<description>R07. A previsão de vida útil só faz sentido se a falha prevista puder virar manutenção agendada.</description>
			<imp>
				<var>RUL</var>
				<var>Manutencao</var>
			</imp>
		</rule>
		<rule>
			<description>R08. No demo, empresa com agenda oferece também o técnico.</description>
			<imp>
				<conj>
					<var>LoginDemo</var>
					<var>Agendamento</var>
				</conj>
				<var>Tecnico</var>
			</imp>
		</rule>
		<rule>
			<description>R09. Só o operador anota detalhes de uma atividade do processo.</description>
			<imp>
				<var>NotasAtividade</var>
				<var>Operador</var>
			</imp>
		</rule>
		<rule>
			<description>R10. Alguém precisa criar processos: o administrador ou o gestor.</description>
			<imp>
				<var>Processo</var>
				<disj>
					<var>Administrador</var>
					<var>Gestor</var>
				</disj>
			</imp>
		</rule>
	</constraints>
</featureModel>
